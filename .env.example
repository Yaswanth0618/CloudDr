# Local development only. Production storage and uploader auth are not configured yet.
STORAGE_MODE=local

# To enable private S3 during local development, put these in .env.local and run
# npm run dev with AWS_PROFILE=cloud-drop-dev. Do not commit .env.local.
# STORAGE_MODE=s3
# CLOUD_DROP_REGION=<PROJECT_REGION>
# CLOUD_DROP_BUCKET=<YOUR_PRIVATE_BUCKET_NAME>

# Public hosting requires AWS mode and server-side environment configuration.
# No long-lived AWS credentials belong in this file: use an IAM compute role.
# STORAGE_MODE=aws
# CLOUD_DROP_TABLE=<DYNAMODB_TABLE_NAME>
# APP_ORIGIN=https://<YOUR_HOSTNAME>
# COGNITO_USER_POOL_ID=<USER_POOL_ID>
# COGNITO_CLIENT_ID=<PUBLIC_APP_CLIENT_ID>
# COGNITO_DOMAIN=https://<COGNITO_MANAGED_LOGIN_DOMAIN>
